# Settings of compose.vps.yaml, the one-VPS deployment on Zcash testnet (docs/deploy-vps.md).
#
#   scripts/vps.sh init     copies this file to .env.vps (mode 0600) and fills the two tokens with random values
#   scripts/vps.sh keys     puts the operator's view-only keys in it (made on your laptop, see docs/deploy-vps.md)
#
# .env.vps holds secrets and is never committed. A line that starts with # is a setting with its default.

# The apex name. Caddy serves it, www.<name>, facilitator.<name>, api.<name> and, with the services on, llm.<name>,
# markdown.<name>, embeddings.<name> and dropbox.<name>: each needs a DNS record that points at this server
Z402_DOMAIN=z402.net

# The operator's API key at the facilitator, which the demo API and the starter services present. Filled by init
Z402_FACILITATOR_TOKEN=

# What a provider that registers with the facilitator (POST /providers) must present. At least 32 characters. Without
# one anyone could register, so docker compose refuses to run with it empty or missing and the facilitator refuses to
# start with a shorter one. Filled by init. A Z402_REGISTRATION_TOKEN exported in your shell wins over this line
Z402_REGISTRATION_TOKEN=

# The operator's shielded payTo address and its unified incoming viewing key, which see deposits and cannot spend.
# Filled by keys, from the view-only file of your laptop. Never a seed
Z402_PAY_TO=
Z402_UIVK=

# The public lightwalletd that the facilitator and the drop box read testnet from
#Z402_LWD_URL=https://testnet.zec.rocks:443

# Price of one call to the demo API's GET /chunk, in zatoshi
#Z402_PRICE_ZAT=500

# How many providers may register with the facilitator, the operator not counted
#Z402_MAX_PROVIDERS=32

# The starter services (llm, markdown, embeddings, dropbox) are off. To turn them on, uncomment the next line, fill in
# a hosted OpenAI-compatible provider for llm and embeddings below (no model runs on the server), add the four DNS
# records, and run scripts/vps.sh up
#COMPOSE_PROFILES=services
#Z402_LLM_BASE_URL=https://openrouter.ai/api/v1
#Z402_LLM_API_KEY=
#Z402_LLM_MODEL=
#Z402_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
#Z402_EMBEDDINGS_API_KEY=
#Z402_EMBEDDINGS_MODEL=text-embedding-3-small

# Where Caddy's ports are published. The defaults serve the world; the lines below are for a trial on one machine
#Z402_PUBLISH_HOST=0.0.0.0
#Z402_HTTP_PORT=80
#Z402_HTTPS_PORT=443

# acme (the default) gets Let's Encrypt certificates. internal has Caddy's own CA sign every site, for a trial on
# localhost with Z402_DOMAIN=localhost: browsers and curl will not trust it
#Z402_TLS=acme
