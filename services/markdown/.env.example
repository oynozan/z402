# URL to markdown (services/markdown). Copy to .env next to this file: `pnpm start` loads it, and compose reads it on
# the host. A variable already set in the environment wins, and an empty value counts as unset.
# This service has no provider and no API key: it fetches public pages itself.

# Shared by every z402 service. In Docker, compose sets these and ignores the values here (PUBLIC_URL excepted).
# Z402_NETWORK=regtest
# Z402_FACILITATOR_URL=http://127.0.0.1:4022
# The facilitator's bearer token, or a file holding it (a relative path is from the working directory, which is this
# one under `pnpm start`)
# Z402_FACILITATOR_TOKEN=
# Z402_FACILITATOR_TOKEN_FILE=../../.data/manual-token
# The merchant's shielded-only unified address, the facilitator's own
# Z402_PAY_TO=
# Z402_PAY_TO_FILE=
# Z402_PRICE_ZAT=500
# PUBLIC_URL=http://localhost:4032
# HOST=127.0.0.1
# PORT=4032

# Ports a page and every redirect may use
# MARKDOWN_ALLOWED_PORTS=80,443,8080,8443
# Largest page body in bytes, counted as received and again after decompression (5 MiB)
# MARKDOWN_MAX_BYTES=5242880
# Largest markdown answer in UTF-8 bytes; a longer one is cut and marked truncated (1 MiB)
# MARKDOWN_MAX_MARKDOWN_BYTES=1048576
# Deadline of one page fetch (DNS, connections, redirects, body), and again of its conversion
# MARKDOWN_TIMEOUT_MS=15000
# MARKDOWN_MAX_REDIRECTS=5
# Page fetches a minute per client IP (an IPv6 client per /64); a cached page costs nothing
# MARKDOWN_RATE_PER_MIN=30
# Pages fetched at once; more get 503 busy
# MARKDOWN_MAX_CONCURRENT=4
# Conversion worker threads, and the heap limit of each. The heap also sets how many tags a page may have:
# (heap - 64) x 300, so 38,400 at 192. Memory: about 330 MB idle, plus up to one heap per busy worker.
# MARKDOWN_CONVERT_WORKERS=1
# MARKDOWN_WORKER_HEAP_MB=192
# How long a converted page answers unpaid attempts from the cache. One that answered an unpaid attempt is held as long
# again for that client's paid retry, and pages that find no room next to the held ones are refused as busy. The bytes
# count the markdown, title, byline and URLs.
# MARKDOWN_CACHE_MS=60000
# MARKDOWN_CACHE_ENTRIES=100
# MARKDOWN_CACHE_BYTES=33554432
# MARKDOWN_USER_AGENT=z402-markdown/0.1
# Express "trust proxy": set it only behind a proxy you run (the number of proxies, or their addresses such as
# loopback), since the rate limit then counts the client IP that proxy reports in X-Forwarded-For. true is refused: it
# takes the left-most address, which the client writes itself
# MARKDOWN_TRUST_PROXY=false
