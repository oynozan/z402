# Any OpenAI-compatible provider works, Ollama is the default
# EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
# Sent as a bearer token when set, EMBEDDINGS_API_KEY_FILE=<path> reads it from a file instead
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=nomic-embed-text
# Limits of one paid call, characters (Unicode code points, summed over all inputs) and strings
# EMBEDDINGS_MAX_CHARS=4000
# Most characters in one input string, unlimited by default; set it to the model's context for a local model
# EMBEDDINGS_MAX_INPUT_CHARS=
# EMBEDDINGS_MAX_INPUTS=64

# Shared by every paid service, the first two are required when the service runs on its own
# Z402_FACILITATOR_URL=http://127.0.0.1:4022
# Z402_PAY_TO=uregtest1...
# Z402_FACILITATOR_TOKEN=
# Z402_NETWORK=regtest
# Z402_PRICE_ZAT=500
# PUBLIC_URL=http://localhost:4033
# HOST=127.0.0.1
# PORT=4033
