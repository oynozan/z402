# LLM inference service. Copy to services/llm/.env; a variable set in the environment wins over the file, and an
# empty value counts as unset. Under Docker, compose reads this .env after docker/env/llm.env, so a line uncommented
# here overrides the Docker default: uncomment only what you mean to change.

# The facilitator's URL, required (compose sets its own)
# Z402_FACILITATOR_URL=http://127.0.0.1:4022
# The facilitator's bearer token, or a file that holds it
# Z402_FACILITATOR_TOKEN=
# Z402_FACILITATOR_TOKEN_FILE=
# The merchant's shielded-only unified address, required and the facilitator's own, or a file that holds it
# Z402_PAY_TO=
# Z402_PAY_TO_FILE=
# regtest, testnet or mainnet
#Z402_NETWORK=regtest
# Price of one call in zatoshi; must equal the facilitator's
#Z402_PRICE_ZAT=500
# Public origin of this service, used as the 402 resource URL and in discovery (default http://localhost:<PORT>)
#PUBLIC_URL=http://localhost:4031
# Listen address (0.0.0.0 in a container) and port
#HOST=127.0.0.1
#PORT=4031

# Provider key, sent as a bearer token (none for a local Ollama or llama.cpp server), or a file that holds it
# LLM_API_KEY=
# LLM_API_KEY_FILE=
# OpenAI-compatible API root: Ollama, vLLM, llama.cpp server, OpenRouter, Groq, Together
#LLM_BASE_URL=http://127.0.0.1:11434/v1
# Model id as the provider lists it; a name without a tag also matches name:latest
#LLM_MODEL=qwen2.5:0.5b
# Tokens per paid chunk, 1 to 512
#LLM_CHUNK_TOKENS=32
# Output cap per stream, and the largest maxTokens a call may ask for, 1 to 32768
#LLM_MAX_TOKENS=1024
# Longest prompt, and longest system prompt, in characters
#LLM_MAX_PROMPT_CHARS=8000
# Streams live at once; a start call beyond that is refused before payment
#LLM_MAX_STREAMS=64
# A stream untouched this long is dropped and its generation stopped
#LLM_STREAM_IDLE_MS=600000
# How long a paid call waits for its chunk, at most 60000 (the 402 promises an answer within 60 s)
#LLM_CHUNK_TIMEOUT_MS=60000
