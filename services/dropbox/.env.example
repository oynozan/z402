# Encrypted drop box. Copy to .env next to this file; a variable set in the environment wins over it.
# An empty value counts as unset.

# regtest, testnet or mainnet
# Z402_NETWORK=regtest
# The facilitator's URL (required)
# Z402_FACILITATOR_URL=http://127.0.0.1:4022
# The facilitator's bearer token, or a file that holds it
# Z402_FACILITATOR_TOKEN=
# Z402_FACILITATOR_TOKEN_FILE=
# The merchant's shielded-only unified address, which must be the facilitator's (required), or a file that holds it
# Z402_PAY_TO=
# Z402_PAY_TO_FILE=
# Price of one call in zatoshi, which must equal the facilitator's
# Z402_PRICE_ZAT=500
# Public origin of this service, used as the 402 resource URL and in discovery
# PUBLIC_URL=http://localhost:4034
# Listen address (0.0.0.0 in a container) and port
# HOST=127.0.0.1
# PORT=4034

# Where the drops live, as <id>.age and <id>.json. A relative path is relative to the working directory.
# docker compose keeps them on the dropbox-data volume (docker/env/dropbox.env), so leave this commented out there.
# DROPBOX_DIR=.data/dropbox
# Largest upload, and largest total of all stored uploads, in bytes
# DROPBOX_MAX_BYTES=1048576
# DROPBOX_MAX_TOTAL_BYTES=268435456
# Blocks one paid call buys, and the most a drop is ever held past the chain tip
# DROPBOX_BLOCKS_PER_CALL=10
# DROPBOX_MAX_HOLD_BLOCKS=1000
# The lightwalletd gRPC endpoint that gives the chain tip, which is the clock of the drop box.
# docker compose points it at Zaino (docker/env/dropbox.env), so leave this commented out there.
# DROPBOX_LWD_URL=http://127.0.0.1:28137
# How often the tip is read, 100 to 30000
# DROPBOX_TIP_POLL_MS=10000
# Upload attempts per minute per client (an IPv6 client per /64), refused 429 before the body is read. The paid retry
# of an attempt that passed its checks is not counted.
# DROPBOX_RATE_PER_MIN=30
