# Docker defaults for services/dropbox. services/dropbox/.env, when it exists, is read after this file and wins.
# compose.yaml fixes HOST, PORT, the network, the facilitator and the payTo. DROPBOX_DIR is the
# dropbox-data volume.
DROPBOX_LWD_URL=http://zaino:8137
DROPBOX_DIR=/data/dropbox
PUBLIC_URL=http://localhost:4034
