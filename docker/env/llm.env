# Docker defaults for services/llm. services/llm/.env, when it exists, is read after this file and wins, so a hosted
# provider and its key go there. compose.yaml fixes HOST, PORT, the network, the price, the facilitator and the payTo.
LLM_BASE_URL=http://llm-model:8080/v1
LLM_MODEL=qwen2.5-0.5b-instruct
PUBLIC_URL=http://localhost:4031
# llama.cpp refuses a prompt longer than its slot (10240 tokens, compose.yaml), and only after the call is paid. Qwen's
# byte-level tokenizer can spend a token on every UTF-8 byte, three for one character (4000 Bamum letters are 11954
# tokens), so a prompt and a system prompt of 1600 characters each stay within 9600 tokens. With a hosted provider, an
# empty LLM_MAX_PROMPT_CHARS= in services/llm/.env brings back the service's own limit.
LLM_MAX_PROMPT_CHARS=1600
