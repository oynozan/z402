# Docker defaults for services/embeddings. services/embeddings/.env, when it exists, is read after this file and wins,
# so a hosted provider and its key go there. compose.yaml fixes HOST, PORT, the network, the facilitator and
# the payTo.
EMBEDDINGS_BASE_URL=http://embed-model:8080/v1
EMBEDDINGS_MODEL=nomic-embed-text
# The local model takes 2048 tokens per input string, and a character can be a whole token, so one string is capped at
# 2000 characters to keep the provider from refusing it after payment. A call still carries 4000 characters, about
# 1,000 tokens of English and the unit sold, across several strings. With a hosted provider, lift the string cap with
# an empty EMBEDDINGS_MAX_INPUT_CHARS= in services/embeddings/.env.
EMBEDDINGS_MAX_CHARS=4000
EMBEDDINGS_MAX_INPUT_CHARS=2000
PUBLIC_URL=http://localhost:4033
