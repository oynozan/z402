# Service URLs, comma-separated. Required unless DISCOVERY_TARGETS is set.
# In compose these are http://llm:4031,http://markdown:4032,http://embeddings:4033,http://dropbox:4034
DISCOVERY_SERVICES=http://127.0.0.1:4031,http://127.0.0.1:4032,http://127.0.0.1:4033,http://127.0.0.1:4034

# Paid routes that are not built on the service kit, as METHOD URL entries, comma-separated.
DISCOVERY_TARGETS=GET http://127.0.0.1:4021/chunk

# Milliseconds between refreshes (1000 or more), and the deadline of each request.
DISCOVERY_REFRESH_MS=30000
DISCOVERY_TIMEOUT_MS=5000

# Listen address. 0.0.0.0 in compose.
HOST=127.0.0.1
PORT=4030
