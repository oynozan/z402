# Compose settings for `docker compose up`. Copy to .env next to compose.yaml and change what you need; every one
# has this default. A service's own settings and API keys go in services/<name>/.env (see docs/deploy.md).

# Address the published ports bind to. 0.0.0.0 serves the website, the API and the services to the network, which a
# server needs. On a laptop use 127.0.0.1, so only this machine reaches them. Docker's published ports bypass ufw.
Z402_PUBLISH_HOST=0.0.0.0

# Host ports
Z402_WEB_PORT=3000
Z402_API_PORT=4021
Z402_LLM_PORT=4031
Z402_MARKDOWN_PORT=4032
Z402_EMBEDDINGS_PORT=4033
Z402_DROPBOX_PORT=4034

# Seconds between the blocks the clock mines. Nothing confirms or expires without blocks.
Z402_BLOCK_SECONDS=25

# Price of one paid call in zatoshi, given to the facilitator, the API and every service alike
Z402_PRICE_ZAT=500

# Local models for the llm and embeddings services, as llama.cpp -hf <Hugging Face repo>:<quant>. Downloaded once
# into the models volume. The services ask for the aliases qwen2.5-0.5b-instruct and nomic-embed-text, which stay.
Z402_LLM_HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct-GGUF:Q4_K_M
Z402_EMBED_HF_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF:Q4_K_M
