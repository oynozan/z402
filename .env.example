# Compose settings for `docker compose up`. Copy to .env next to compose.yaml and change what you need; every one
# has this default. A service's own settings and API keys go in services/<name>/.env (see docs/deploy.md).

# Address the published ports bind to. 0.0.0.0 serves the website, the API and the services to the network, which a
# server needs. On a laptop use 127.0.0.1, so only this machine reaches them. Docker's published ports bypass ufw.
Z402_PUBLISH_HOST=0.0.0.0

# Host ports. A service's PUBLIC_URL (services/<name>/.env) names the port agents use, so change both together.
Z402_WEB_PORT=3000
Z402_API_PORT=4021
Z402_LLM_PORT=4031
Z402_MARKDOWN_PORT=4032
Z402_EMBEDDINGS_PORT=4033
Z402_DROPBOX_PORT=4034

# Seconds between the blocks the clock mines. Nothing confirms or expires without blocks.
Z402_BLOCK_SECONDS=25

# Price of one paid call to the demo API's GET /chunk, in zatoshi. Each starter service sets its own price, which its
# services/<name>/.env can change with Z402_PRICE_ZAT
Z402_PRICE_ZAT=500

# The origin agents reach the demo API at, which its entry in the service catalog names. On a server, its public
# origin, such as https://api.example.com; the default follows Z402_API_PORT
Z402_API_PUBLIC_URL=http://localhost:4021

# The token a provider must present to register itself with the facilitator (POST /providers), a b64token such as the
# output of `openssl rand -hex 32`. Empty leaves registration open, which is safe only while the facilitator's port
# stays unpublished, as compose.yaml keeps it. Set it before outside providers connect (docs/deploy.md).
# markdown-register sends it for provider 2.
Z402_REGISTRATION_TOKEN=

# Local models for the llm and embeddings services, as llama.cpp -hf <Hugging Face repo>:<quant>. Downloaded once
# into the models volume. The services ask for the aliases qwen2.5-0.5b-instruct and nomic-embed-text, which stay.
# A replacement needs at least the same context: 10240 tokens for the chat model, 2048 for the embedding model.
Z402_LLM_HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct-GGUF:Q4_K_M
Z402_EMBED_HF_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF:Q4_K_M

# 1 runs the local model, 0 leaves it out once services/llm/.env or services/embeddings/.env names a hosted provider
Z402_LLM_MODEL_SCALE=1
Z402_EMBED_MODEL_SCALE=1
