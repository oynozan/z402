{
  "name": "@z402-net/client",
  "version": "0.1.0",
  "description": "The paying side of z402: an x402 client scheme that makes shielded Zcash deposits and signs prepaid vouchers for an agent",
  "keywords": [
    "x402",
    "zcash",
    "shielded",
    "payments",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oynozan/z402.git",
    "directory": "packages/client"
  },
  "homepage": "https://z402.net/docs/reference/client",
  "bugs": "https://github.com/oynozan/z402/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@z402-net/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@x402/core": "2.28.0"
  },
  "devDependencies": {
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@z402/testkit": "workspace:*"
  }
}
