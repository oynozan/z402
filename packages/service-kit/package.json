{
  "name": "@z402/service-kit",
  "version": "0.1.0",
  "description": "Build a paid HTTP service for z402: the x402 Express middleware wired to the prepaid-voucher scheme, with start-up checks and Bazaar listing",
  "keywords": [
    "x402",
    "zcash",
    "shielded",
    "payments",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oynozan/z402.git",
    "directory": "packages/service-kit"
  },
  "homepage": "https://z402.net",
  "bugs": "https://github.com/oynozan/z402/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@z402/protocol": "workspace:*",
    "@z402/server": "workspace:*",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@x402/fetch": "2.28.0",
    "@z402/client": "workspace:*",
    "@z402/facilitator": "workspace:*",
    "@z402/testkit": "workspace:*"
  }
}
