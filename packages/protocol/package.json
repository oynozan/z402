{
  "name": "@z402/protocol",
  "version": "0.1.0",
  "description": "The z402 prepaid-voucher wire format for x402 on Zcash: payment terms, voucher signatures, deposit memos and the trust ramp",
  "keywords": [
    "x402",
    "zcash",
    "shielded",
    "payments",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oynozan/z402.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://z402.net",
  "bugs": "https://github.com/oynozan/z402/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0"
  }
}
